{
  "name": "obelisk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "dev:next": "next dev",
    "dev:raise": "./scripts/dev-raise.sh",
    "raise": "./scripts/raise.sh",
    "deploy": "./scripts/deploy.sh",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config=scripts/e2e/playwright.config.ts",
    "test:e2e:headed": "HEADED=1 playwright test --config=scripts/e2e/playwright.config.ts",
    "test:e2e:voice": "playwright test --config=scripts/e2e/playwright.config.ts scripts/e2e/voice/",
    "test:e2e:voice:headed": "HEADED=1 playwright test --config=scripts/e2e/playwright.config.ts scripts/e2e/voice/",
    "snap-guides": "tsx scripts/snap-guide-svgs.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@nostr-wot/data": "^0.5.1",
    "@nostr-wot/dm": "^0.6.1",
    "@nostr-wot/pq": "^0.2.1",
    "@nostr-wot/signers": "^1.2.0",
    "@nostr-wot/ui": "^0.7.1",
    "@nostr-wot/wallet": "^0.3.3",
    "gray-matter": "^4.0.3",
    "html-to-image": "^1.11.13",
    "light-bolt11-decoder": "^3.2.0",
    "mediasoup-client": "^3.20.0",
    "next": "16.2.2",
    "next-mdx-remote": "^5.0.0",
    "nostr-tools": "^2.23.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-peer": "^9.11.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/simple-peer": "^9.11.9",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.4",
    "typescript": "^5",
    "vitest": "^4.1.3"
  }
}
